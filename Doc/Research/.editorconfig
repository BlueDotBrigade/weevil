# The research projects are dated records (Doc/README.md): they keep, as warnings, the rules the rest of the repository makes errors.
[*.cs]

# Use var (#1273)
dotnet_diagnostic.IDE0007.severity = warning

# Use explicit type (#1270)
dotnet_diagnostic.IDE0008.severity = warning

# Add 'this' qualification (#1272)
dotnet_diagnostic.IDE0009.severity = warning

# Use TestMethod instead of the obsolete DataTestMethod (#1274)
dotnet_diagnostic.MSTEST0044.severity = warning

# Identifiers should be spelled correctly (#1271)
dotnet_diagnostic.CA1704.severity = warning

# Add braces (#1275)
dotnet_diagnostic.IDE0011.severity = warning

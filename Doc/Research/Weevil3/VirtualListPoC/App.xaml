<Application x:Class="Weevil.VirtualListPoC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             ShutdownMode="OnMainWindowClose">
    <!-- As Weevil's App.xaml, without the styles for controls this window does not have. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WeevilCopies/ApplicationStyles.xaml" />

                <materialDesign:CustomColorTheme BaseTheme="Dark" PrimaryColor="{StaticResource PrimaryColor}" SecondaryColor="{StaticResource SecondaryColor}" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary>
                    <SolidColorBrush x:Key="MaterialDesignPaper" Color="{StaticResource SurfaceBackgroundColor}" />
                    <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="{StaticResource SurfaceCardColor}" />
                    <SolidColorBrush x:Key="MaterialDesignBody" Color="{StaticResource TextColor}" />
                    <SolidColorBrush x:Key="MaterialDesignDivider" Color="{StaticResource SubtleOutlineColor}" />
                    <SolidColorBrush x:Key="MaterialDesignTextBoxBorder" Color="{StaticResource InputOutlineColor}" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

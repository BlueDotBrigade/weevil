<Project Sdk="Microsoft.NET.Sdk">
  <!-- A sample host with Weevil-like options, without Weevil: it reads sidecars with plain XML (#1157). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the project build on Linux too; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>OpenAsDialogPoC</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dialogs\BlueDotBrigade.Windows.Dialogs.csproj" />
  </ItemGroup>
</Project>

<!-- A small dark theme, applied application-wide, to check that the generic dialog takes the host's styles (#1157).
     It styles standard controls by type only, as MaterialDesign's defaults do in Weevil. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="DarkBackground" Color="#0D1117" />
    <SolidColorBrush x:Key="DarkSurface" Color="#161B22" />
    <SolidColorBrush x:Key="DarkBorder" Color="#30363D" />
    <SolidColorBrush x:Key="DarkText" Color="#E6EDF3" />

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource DarkSurface}" />
        <Setter Property="Foreground" Value="{StaticResource DarkText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorder}" />
        <Setter Property="CaretBrush" Value="{StaticResource DarkText}" />
    </Style>
    <Style TargetType="ListView">
        <Setter Property="Background" Value="{StaticResource DarkSurface}" />
        <Setter Property="Foreground" Value="{StaticResource DarkText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorder}" />
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource DarkBackground}" />
        <Setter Property="Foreground" Value="{StaticResource DarkText}" />
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource DarkText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorder}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource DarkText}" />
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource DarkText}" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource DarkText}" />
    </Style>
</ResourceDictionary>

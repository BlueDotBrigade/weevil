<Window x:Class="OpenAsDialogPoC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open As dialog: proof of concept" Width="700" Height="360" WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="ApplicationCommands.Open" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnOpen" />
    </Window.CommandBindings>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Content="_Open…" Command="ApplicationCommands.Open" MinWidth="100" Padding="8,4" />
            <CheckBox x:Name="DarkThemeBox" Content="Dark _theme" Margin="16,0,0,0" VerticalAlignment="Center"
                      Checked="OnThemeChanged" Unchecked="OnThemeChanged" />
        </StackPanel>
        <TextBox x:Name="ResultText" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Result" Text="Press Open (Ctrl+O). What you choose is shown here." />
    </DockPanel>
</Window>

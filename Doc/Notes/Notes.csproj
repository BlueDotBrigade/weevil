<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(WeevilTargetFramework)</TargetFramework>
		<Platforms>x64</Platforms>
		<RootNamespace>Notes</RootNamespace>
		<Authors>BlueDotBrigade;</Authors>
		<Copyright>© 2026 Blue Dot Brigade</Copyright>
		<Owners>Blue Dot Brigade</Owners>

		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE.md" Link="Release\Licenses\LICENSE.md" />
	</ItemGroup>

	<ItemGroup>
		<!-- GeneratePathProperty gives the build the restored package's folder, $(PkgMarkdig), to pass to MarkdownConverter.ps1. -->
		<PackageReference Include="Markdig" Version="1.4.2" GeneratePathProperty="true" />
	</ItemGroup>

	<Target Name="GenerateNotesHtml"
			AfterTargets="Build"
			Condition="Exists('$(ProjectDir)MarkdownConverter.ps1')">

		<Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)MarkdownConverter.ps1&quot; -MarkdigAssemblyPath &quot;$([System.IO.Path]::Combine($(PkgMarkdig), 'lib', 'netstandard2.0', 'Markdig.dll'))&quot;"
			  ConsoleToMsBuild="true" />

	</Target>

</Project>
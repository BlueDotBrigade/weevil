<Project>
  <PropertyGroup>
    <!-- The .NET version of every project, and of the installer's paths and runtime check. Windows projects append `-windows`, or a Windows version such as `-windows10.0.19041.0`. -->
    <WeevilTargetFramework>net10.0</WeevilTargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' != '.wixproj'">
    <WeevilReleaseVersion>3.0.0</WeevilReleaseVersion>
    <VersionPrefix>$(WeevilReleaseVersion)</VersionPrefix>
    <BuildRevisionRaw Condition="'$(BuildRevisionRaw)' == '' and '$(BUILD_BUILDID)' != ''">$(BUILD_BUILDID)</BuildRevisionRaw>
    <BuildRevisionRaw Condition="'$(BuildRevisionRaw)' == '' and '$(GITHUB_RUN_NUMBER)' != ''">$(GITHUB_RUN_NUMBER)</BuildRevisionRaw>
    <BuildRevisionRaw Condition="'$(BuildRevisionRaw)' == ''">$([System.DateTimeOffset]::UtcNow.ToUnixTimeSeconds())</BuildRevisionRaw>
    <BuildRevision Condition="'$(BuildRevision)' == ''">$([MSBuild]::Modulo($([System.Int64]::Parse('$(BuildRevisionRaw)')), 65535))</BuildRevision>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(BUILD_BUILDID)' != '' or '$(GITHUB_RUN_NUMBER)' != ''">true</ContinuousIntegrationBuild>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).$(BuildRevision)</FileVersion>
    <InformationalVersion>$(VersionPrefix)+$(Configuration).$(BuildRevision)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Report the code style rules in .editorconfig during the build, not only in the IDE. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <!-- BDB000: dsl.config.xml is missing or can't be parsed, so BlueDotBrigade.Analyzers checks nothing. An error, so a typo in the file fails the build (#1347). It has no location in a file, so .editorconfig's severities don't reach it. -->
    <WarningsAsErrors>$(WarningsAsErrors);BDB000</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <!-- Words the spelling rule accepts: CA1704, from Text.Analyzers, which only Common references (#1271). Text.Analyzers reads an .xml or .dic whose name contains "dictionary" or "custom". -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)DomainSpecificDictionary.xml" Link="Properties\DomainSpecificDictionary.xml" />
    <!-- Weevil's vocabulary: the terms BlueDotBrigade.Analyzers reports in a name (BDB001, #1347). Version 1.0.0 doesn't add dsl.config.xml itself, so the item below is needed. -->
    <PackageReference Include="BlueDotBrigade.Analyzers" Version="1.0.0" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)dsl.config.xml" Link="Properties\dsl.config.xml" />
  </ItemGroup>
</Project>
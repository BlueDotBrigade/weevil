<Project Sdk="Microsoft.NET.Sdk">
	<!-- Tests the WPF libraries' types that need no window, such as the file browser's model (#1210, #1333). It runs only on Windows, as the libraries do. -->
	<PropertyGroup>
		<TargetFramework>$(WeevilTargetFramework)-windows</TargetFramework>
		<OutputType>Library</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>BlueDotBrigade.Weevil.Windows</RootNamespace>
		<PlatformTarget>x64</PlatformTarget>
		<Platforms>x64</Platforms>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
		<OutputPath>bin\x64\Debug\</OutputPath>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
		<OutputPath>bin\x64\Release\</OutputPath>
	</PropertyGroup>
	<ItemGroup>
		<!-- NOTE: Upgrading FluentAssertions to v8 requires a license. #475 -->
		<PackageReference Include="FluentAssertions" Version="[7.0.0]" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
		<PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
		<PackageReference Include="NSubstitute" Version="6.2.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\Src\BlueDotBrigade.Weevil.Windows\BlueDotBrigade.Weevil.Windows.csproj" />
		<ProjectReference Include="..\..\Src\BlueDotBrigade.Weevil.Windows.Dialogs\BlueDotBrigade.Weevil.Windows.Dialogs.csproj" />
	</ItemGroup>
</Project>

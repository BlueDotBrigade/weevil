<?xml version="1.0" encoding="utf-8"?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<Fragment>

		<ComponentGroup Id="TelemetryCredentialsComponents">
			<ComponentRef Id="TelemetryCredentials" />
		</ComponentGroup>

		<DirectoryRef Id="INSTALLFOLDER">
			<Component Id="TelemetryCredentials"
					   Guid="9B0E5316-BF8E-48FC-9698-63C9816EFAEC">

				<!--
					An empty string will result in a compiler error.
					WIX0006 : The Environment/@Value attribute's value cannot be an empty string. If a value is not required, simply remove the entire attribute.
				-->
				<Environment Id="TelemetryUsername"
							 Name="WEEVIL_TELEMETRY_USERNAME"
							 Value="NOT_SET"
							 Action="set"
							 Part="all"
							 System="yes"
							 Permanent="no" />

				<!--
					An empty string will result in a compiler error.
					WIX0006 : The Environment/@Value attribute's value cannot be an empty string. If a value is not required, simply remove the entire attribute.
				-->
				<Environment Id="TelemetrySecret"
							 Name="WEEVIL_TELEMETRY_SECRET"
							 Value="NOT_SET"
							 Action="set"
							 Part="all"
							 System="yes"
							 Permanent="no" />

			</Component>
		</DirectoryRef>

	</Fragment>
</Wix>
<UserControl x:Class="BlueDotBrigade.Weevil.Gui.IO.OpenAsOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:BlueDotBrigade.Weevil.Gui.Converters">
    <!-- Weevil's options, which the Open As dialog shows beside its file browser: the part of the log to open (#1214), then RAM or Disk (#1215). -->
    <UserControl.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Foreground" Value="{StaticResource TextForeground}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="HiddenWhenEmpty" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="5,10,5,0" />
            <Setter Property="Foreground" Value="{StaticResource TextForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Log" FontWeight="SemiBold" />
        <TextBlock x:Name="DetailsText" Text="{Binding Details}" AutomationProperties.Name="Log details" />

        <!-- One way to narrow the log at a time (decision 5 of the #1157 plan). Picking a section or region, or typing a line, chooses it. -->
        <StackPanel IsEnabled="{Binding HasFile}" Margin="0,10,0,0">
            <TextBlock Text="Which part of the log should Weevil open?" FontWeight="SemiBold" />

            <RadioButton x:Name="WholeLogRadioButton" GroupName="Part" Content="_Whole log"
                         IsChecked="{Binding ChosenPart, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Whole}" />

            <RadioButton x:Name="SectionRadioButton" GroupName="Part" Content="_Section" IsEnabled="{Binding HasSections}"
                         ToolTip="A level-1 section of the log's table of contents, with the sections inside it."
                         IsChecked="{Binding ChosenPart, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Section}" />
            <ComboBox x:Name="SectionComboBox" ItemsSource="{Binding Sections}" SelectedIndex="{Binding ChosenSectionIndex, Mode=TwoWay}"
                      IsEnabled="{Binding HasSections}" Margin="30,0,5,5" AutomationProperties.Name="Section" />

            <RadioButton x:Name="RegionRadioButton" GroupName="Part" Content="Re_gion" IsEnabled="{Binding HasRegions}"
                         ToolTip="A named region of the log."
                         IsChecked="{Binding ChosenPart, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Region}" />
            <ComboBox x:Name="RegionComboBox" ItemsSource="{Binding Regions}" SelectedIndex="{Binding ChosenRegionIndex, Mode=TwoWay}"
                      IsEnabled="{Binding HasRegions}" Margin="30,0,5,5" AutomationProperties.Name="Region" />

            <RadioButton x:Name="LinesRadioButton" GroupName="Part" Content="_Lines"
                         IsChecked="{Binding ChosenPart, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Lines}" />
            <StackPanel Orientation="Horizontal" Margin="30,0,5,5">
                <TextBlock Text="From" VerticalAlignment="Center" />
                <TextBox x:Name="FirstLineTextBox" Text="{Binding FirstLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="80"
                         AutomationProperties.Name="First line" />
                <TextBlock Text="to" VerticalAlignment="Center" />
                <TextBox x:Name="LastLineTextBox" Text="{Binding LastLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="80"
                         ToolTip="Leave it empty to open to the end of the log."
                         AutomationProperties.Name="Last line, or empty for the end of the log" />
            </StackPanel>

            <TextBlock x:Name="PartErrorText" Text="{Binding PartError}" Style="{StaticResource HiddenWhenEmpty}"
                       FontWeight="SemiBold" Margin="5,0,5,5" />
        </StackPanel>

        <StackPanel IsEnabled="{Binding HasFile}" Margin="0,10,0,0">
            <TextBlock Text="Where should Weevil keep the log's text while it is open?" FontWeight="SemiBold" />

            <RadioButton x:Name="RamRadioButton" GroupName="StorageMode" Content="_RAM"
                         IsChecked="{Binding ChosenMode, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Ram}"
                         AutomationProperties.HelpText="{Binding RamDescription}" />
            <TextBlock Text="{Binding RamDescription}" Margin="30,0,5,5" />

            <RadioButton x:Name="DiskRadioButton" GroupName="StorageMode" Content="_Disk"
                         IsChecked="{Binding ChosenMode, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Disk}"
                         AutomationProperties.HelpText="{Binding DiskDescription}" />
            <TextBlock Text="{Binding DiskDescription}" Margin="30,0,5,5" />

            <TextBlock Text="{Binding Suggestion}" Style="{StaticResource HiddenWhenEmpty}" Margin="5,10,5,5" />
            <TextBlock x:Name="WarningText" Text="{Binding Warning}" Style="{StaticResource HiddenWhenEmpty}"
                       FontWeight="SemiBold" Margin="5,10,5,5" />
        </StackPanel>
    </StackPanel>
</UserControl>

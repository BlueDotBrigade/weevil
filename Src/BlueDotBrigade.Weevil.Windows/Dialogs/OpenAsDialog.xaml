<Window x:Class="BlueDotBrigade.Weevil.Windows.Dialogs.OpenAsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BlueDotBrigade.Weevil.Windows.Dialogs"
        x:Name="Self"
        Title="Open" Width="1100" Height="640" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- No colours or theme of its own: the host sets them, or its application-wide styles apply (#1157). -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <local:FileBrowser x:Name="FileBrowserControl" Grid.Row="0" Grid.Column="0" />

        <!-- The host's options, such as which part of the file to open. -->
        <ScrollViewer x:Name="OptionsArea" Grid.Row="0" Grid.Column="2" Width="340" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ContentPresenter Content="{Binding OptionsContent, ElementName=Self}" />
        </ScrollViewer>

        <!-- The host's notice, such as the terms the user accepts by opening a file. Hidden when the host gives none. -->
        <ContentPresenter x:Name="NoticeArea" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" HorizontalAlignment="Right"
                          Content="{Binding Notice, ElementName=Self}" Visibility="Collapsed" />

        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0" LastChildFill="True">
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
            <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="_Open" IsDefault="True" MinWidth="90" IsEnabled="False" Click="OnOpenClick" />
            <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
